# Copy to .env next to where the server is started. Variables set in the
# environment take precedence over this file.

# Encrypts the session inside each addon URL. Changing it invalidates every URL.
# Generate one with: openssl rand -hex 32
SECRET_KEY=

PORT=7007
LOG_LEVEL=info

# Where Nuvio sign-ins are kept. Losing it means Nuvio users sign in again.
DATA_DIR=data

# This server fetches episode lists from the meta addons in each user's Stremio
# collection, so on a public instance anyone could point it at your own network.
# Off, addons on loopback, private, link-local or CGNAT addresses are refused, even
# behind a DNS name or a redirect. Only turn it on for a private, single-user instance.
ALLOW_PRIVATE_ADDON_URLS=false

# How long a read may spend before answering without the watched history.
PULL_BUDGET_SECONDS=15
